// ─── InvoiceShield · Prisma Schema ────────────────────────────────────
// Convenciones: tablas snake_case, campos camelCase.
// Auditoría: la tabla audit_logs es WORM (ver migración SQL de triggers).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ── Enums ─────────────────────────────────────────────────────────────
enum UserRole {
  ADMIN
  ANALYST
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum InvoiceStatus {
  PENDING
  VALIDATED
  BLOCKED
}

enum ValidationType {
  SUNAT_CONFORMITY
  CAVALI_FACTRACK
}

enum AnomalyType {
  CREDIT_NOTE
  DISCONFORMITY
}

// ── Models ────────────────────────────────────────────────────────────
model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  fullName           String
  passwordHash       String
  role               UserRole       @default(ANALYST)
  status             UserStatus     @default(ACTIVE)
  mustChangePassword Boolean        @default(false)
  factorId           String?
  factor             Factor?        @relation(fields: [factorId], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  sessions           Session[]

  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@map("sessions")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  failed    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([email, ip])
  @@map("login_attempts")
}

model Factor {
  id                    String       @id @default(cuid())
  name                  String
  ruc                   String       @unique
  status                String       @default("ACTIVE")
  createdAt             DateTime     @default(now())
  users                 User[]
  invoices              Invoice[]
  fraudAlertsExisting   FraudAlert[] @relation("FraudExistingFactor")
  fraudAlertsAttempted  FraudAlert[] @relation("FraudAttemptedFactor")

  @@map("factors")
}

model Invoice {
  id           String         @id @default(cuid())
  rucEmisor    String
  rucReceptor  String
  numero       String
  monto        Decimal        @db.Decimal(12, 2)
  currency     String         @default("PEN")
  hash         String         @unique
  status       InvoiceStatus  @default(PENDING)
  factorId     String
  factor       Factor         @relation(fields: [factorId], references: [id])
  metadata     String?
  registeredBy String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  validations  Validation[]
  anomalies    Anomaly[]

  @@index([status])
  @@index([createdAt])
  @@map("invoices")
}

model Validation {
  id        String         @id @default(cuid())
  invoiceId String
  invoice   Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type      ValidationType
  signedBy  String
  txHash    String?
  createdAt DateTime       @default(now())

  @@unique([invoiceId, type])
  @@map("validations")
}

model Anomaly {
  id        String      @id @default(cuid())
  invoiceId String
  invoice   Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type      AnomalyType
  detail    String
  createdAt DateTime    @default(now())

  @@map("anomalies")
}

model FraudAlert {
  id                String  @id @default(cuid())
  invoiceHash       String
  rucEmisor         String
  rucReceptor       String
  numero            String
  monto             Decimal @db.Decimal(12, 2)
  existingFactorId  String
  existingFactor    Factor  @relation("FraudExistingFactor", fields: [existingFactorId], references: [id])
  existingInvoiceId String
  attemptedFactorId String
  attemptedFactor   Factor  @relation("FraudAttemptedFactor", fields: [attemptedFactorId], references: [id])
  message           String
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@map("fraud_alerts")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  tableName   String
  recordId    String
  operation   String
  actorUserId String?
  oldData     Json?
  newData     Json?
  createdAt   DateTime @default(now())

  @@index([tableName, recordId])
  @@map("audit_logs")
}
