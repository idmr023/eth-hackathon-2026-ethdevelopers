// ─── InvoiceShield · Prisma Schema Unificado ──────────────────────────
// Convenciones: tablas snake_case, campos camelCase.
// Auditoría: audit_logs es WORM (ver migración SQL de triggers).
// Tablas blockchain: nombres existentes en BD (auction, delegation, audit_verdict, audit_log)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ── Enums ─────────────────────────────────────────────────────────────
enum UserRole {
  ADMIN
  ANALYST
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum InvoiceStatus {
  PENDING
  VALIDATED
  BLOCKED
}

enum ValidationType {
  SUNAT_CONFORMITY
  CAVALI_FACTRACK
}

enum AnomalyType {
  CREDIT_NOTE
  DISCONFORMITY
}

// Blockchain enums (nombres existentes en BD)
enum AuctionStatus {
  ACTIVE
  SETTLED
  CANCELLED
}

enum DelegationStatus {
  PENDING
  REVEALED
  FAILED
}

// ── Models: Core InvoiceShield ──────────────────────────────────────
model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  fullName           String
  passwordHash       String
  role               UserRole       @default(ANALYST)
  status             UserStatus     @default(ACTIVE)
  mustChangePassword Boolean        @default(false)
  factorId           String?
  factor             Factor?        @relation(fields: [factorId], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  sessions           Session[]

  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@map("sessions")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  failed    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([email, ip])
  @@map("login_attempts")
}

model Factor {
  id                    String       @id @default(cuid())
  name                  String
  ruc                   String       @unique
  status                String       @default("ACTIVE")
  createdAt             DateTime     @default(now())
  users                 User[]
  invoices              Invoice[]
  fraudAlertsExisting   FraudAlert[] @relation("FraudExistingFactor")
  fraudAlertsAttempted  FraudAlert[] @relation("FraudAttemptedFactor")

  @@map("factors")
}

model Invoice {
  id           String         @id @default(cuid())
  rucEmisor    String
  rucReceptor  String
  numero       String
  monto        Decimal        @db.Decimal(12, 2)
  currency     String         @default("PEN")
  hash         String         @unique
  status       InvoiceStatus  @default(PENDING)
  factorId     String
  factor       Factor         @relation(fields: [factorId], references: [id])
  metadata     String?
  registeredBy String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  validations  Validation[]
  anomalies    Anomaly[]

  @@index([status])
  @@index([createdAt])
  @@map("invoices")
}

model Validation {
  id        String         @id @default(cuid())
  invoiceId String
  invoice   Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type      ValidationType
  signedBy  String
  txHash    String?
  createdAt DateTime       @default(now())

  @@unique([invoiceId, type])
  @@map("validations")
}

model Anomaly {
  id        String      @id @default(cuid())
  invoiceId String
  invoice   Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type      AnomalyType
  detail    String
  createdAt DateTime    @default(now())

  @@map("anomalies")
}

model FraudAlert {
  id                String  @id @default(cuid())
  invoiceHash       String
  rucEmisor         String
  rucReceptor       String
  numero            String
  monto             Decimal @db.Decimal(12, 2)
  existingFactorId  String
  existingFactor    Factor  @relation("FraudExistingFactor", fields: [existingFactorId], references: [id])
  existingInvoiceId String
  attemptedFactorId String
  attemptedFactor   Factor  @relation("FraudAttemptedFactor", fields: [attemptedFactorId], references: [id])
  message           String
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@map("fraud_alerts")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  tableName   String
  recordId    String
  operation   String
  actorUserId String?
  oldData     Json?
  newData     Json?
  createdAt   DateTime @default(now())

  @@index([tableName, recordId])
  @@map("audit_logs")
}

// ── Models: Blockchain (nombres de tablas existentes en BD) ──────────
// Mirror de BlindBidVault.sol auctions
model Auction {
  id               String          @id @default(cuid())
  contractAddress  String          @map("contract_address") @db.VarChar(42)
  auctionId        BigInt          @map("auction_id")
  title            String          @db.VarChar(255)
  description      String?         @db.VarChar(2000)
  status           AuctionStatus   @default(ACTIVE)
  organizerAddress String          @map("organizer_address") @db.VarChar(42)
  treasuryAddress  String          @map("treasury_address") @db.VarChar(42)
  tokenAddress     String          @map("token_address") @db.VarChar(42)
  stakeAmount      BigInt          @map("stake_amount")
  minPrice         BigInt          @map("min_price")
  maxPrice         BigInt          @map("max_price")
  priceWeight      Int             @map("price_weight")
  qualityWeight    Int             @map("quality_weight")
  commitEnd        DateTime        @map("commit_end")
  revealEnd        DateTime        @map("reveal_end")
  winner           String?         @db.VarChar(42)
  winningPrice     BigInt?         @map("winning_price")
  createdBlock     BigInt?         @map("created_block")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  delegations Delegation[]
  verdicts    AuditVerdict[]

  @@unique([contractAddress, auctionId], name: "auction_contract_address_auction_id_key")
  @@index([status])
  @@index([organizerAddress])
  @@index([revealEnd])
  @@map("auction")
}

// Secretos delegados por bidders para auto-reveal (agent)
model Delegation {
  id               String             @id @default(cuid())
  auctionId        String             @map("auction_id")
  auction          Auction            @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderAddress    String             @map("bidder_address") @db.VarChar(42)
  commitmentHash   String             @map("commitment_hash") @db.VarChar(66)
  price            BigInt
  secretEncrypted  String?            @map("secret_encrypted")
  proposalUri      String?            @map("proposal_uri") @db.VarChar(500)
  status           DelegationStatus   @default(PENDING)
  revealTxHash     String?            @map("reveal_tx_hash") @db.VarChar(66)
  error            String?            @db.VarChar(500)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@unique([auctionId, bidderAddress], name: "delegation_auction_id_bidder_address_key")
  @@index([status])
  @@map("delegation")
}

// AI quality scores (auditor)
model AuditVerdict {
  id            String   @id @default(cuid())
  auctionId     String   @map("auction_id")
  auction       Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderAddress String   @map("bidder_address") @db.VarChar(42)
  aiScore       Int      @map("ai_score")
  docHash       String?  @map("doc_hash") @db.VarChar(66)
  summaryUri    String?  @map("summary_uri")
  modelVersion  String?  @map("model_version")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([auctionId, bidderAddress], name: "audit_verdict_auction_id_bidder_address_key")
  @@map("audit_verdict")
}

// Log de auditoría blockchain (tabla separada de audit_logs WORM)
model AuditLogBC {
  id         String   @id @default(cuid())
  entityType String   @db.VarChar(50)
  entityId   String
  action     String   @db.VarChar(100)
  actorType  String?  @map("actor_type") @db.VarChar(50)
  actorId    String?  @map("actor_id") @db.VarChar(100)
  metadata   Json?
  txHash     String?  @map("tx_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}