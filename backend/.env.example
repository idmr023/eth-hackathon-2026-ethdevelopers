# ─── InvoiceShield Backend ─────────────────────────────────────────────
# Copia este archivo a .env y completa los valores. NUNCA subas .env al repo.

# PostgreSQL en Neon (el usuario completa este valor)
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX.region.aws.neon.tech/neondb?sslmode=require"

# URL sin pooling (necesario para prisma migrate deploy en Neon)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-XXXX.region.aws.neon.tech/neondb?sslmode=require"

# Puerto del servidor
PORT=4000

# Entorno: development | production | test
NODE_ENV=development

# JWT (obligatorio: minimo 32 caracteres)
JWT_ACCESS_SECRET="change-me-min-32-chars-secret-000000000000"
JWT_REFRESH_SECRET="change-me-min-32-chars-secret-111111111111"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Origenes permitidos para CORS / validacion CSRF (separados por coma, UN solo string)
# Incluye el origen del frontend desplegado, ej:
# ALLOWED_ORIGINS="http://localhost:3000,https://TU-FRONT.vercel.app"
ALLOWED_ORIGINS="http://localhost:3000,https://eth-hackathon-2026-ethdevelopers.vercel.app"

# Credenciales del seed (solo pre-produccion)
SEED_ADMIN_EMAIL="admin@invoiceshield.dev"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Blockchain Agent: clave de 32 bytes (64 hex chars) para AES-256-GCM (cifra reveal secrets)
# Generar con: openssl rand -hex 32
AGENT_ENCRYPTION_KEY=""

# Blockchain (Arbitrum Sepolia / BlindBidVault). RPC y signer del operador.
ARBITRUM_RPC_URL="https://arb-sepolia.g.alchemy.com/v2/XXXXXXXX"
ARBITRUM_PRIVATE_KEY=""
ARBITRUM_CHAIN_ID="421614"
ARBITRUM_TOKEN_DECIMALS="6"
# Contrato BlindBidVault desplegado en Arbitrum Sepolia (mayo 2026)
BLIND_BID_VAULT_ADDRESS="0x80d5408c6a0496e7318b94613d11128ba9d844ff"
